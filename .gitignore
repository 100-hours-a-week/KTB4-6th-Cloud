v2/monitoring/.artifacts/

# load-test: 실제 계정과 토큰을 담은 로컬 fixture 및 오디오 샘플은 저장소에 올리지 않는다.
v1/load-test/fixtures.credentials.local.json
v1/load-test/fixtures.teams.credentials.local.json
v1/load-test/fixtures.local.json
v1/load-test/audio.local.*
v1/load-test/reports/

# 부하 발생기 OS에 맞춰 빌드한 SSE 확장 실행 파일
v1/load-test/k6-sse

# ProxySQL 런타임 설정 DB: 앱 계정 비밀번호가 평문으로 저장된다
v1/*/app/proxysql/data/

# DB 이전 리허설 결과: k6 요청 기록과 서울 DB 조회 결과는 실행마다 로컬에만 둔다 (전환 로그는 위 *.log로 제외)
v1/migration/ops-*.jsonl
v1/migration/meetings-*.tsv
v1/migration/live-*.tsv
v1/migration/segments-*.tsv
v1/migration/k6-*.out
v1/migration/verify-*.txt

# 리허설 종료 후에도 로컬 원본 결과는 보존하되 실행별 로그와 대시보드는 커밋하지 않는다.
v1/migration/collect-*.out
v1/migration/preflight-*.out
v1/migration/reset-*.out
v1/migration/switch-*.out
v1/migration/verify-*.out
v1/migration/k6-*.html
