# NEXT_PUBLIC_* 값은 FE 이미지 빌드 시 GitHub Actions에서 주입한다.
# Backend의 S3 접근은 EC2 IAM 역할 인증을 사용한다.

# 이미지 태그 (CI/CD가 관리)
FE_IMAGE_TAG={Image-Tag}
BE_IMAGE_TAG={Image-Tag}

# Frontend 런타임
API_BASE_URL=http://backend:8080
AUTH_COOKIE_DOMAIN={AUTH_COOKIE_DOMAIN}
BUG_REPORT_DISCORD_WEBHOOK_URL={BUG_REPORT_DISCORD_WEBHOOK_URL}

# Backend 데이터베이스
DATA_TIER_HOST={DATA_TIER_HOST}
DB_NAME={DB_NAME}
DB_USER={DB_USER}
DB_PASSWORD={DB_PASSWORD}

# Backend 인증과 접근 제어
KAKAO_CLIENT_ID={KAKAO_CLIENT_ID}
KAKAO_CLIENT_SECRET={KAKAO_CLIENT_SECRET}
KAKAO_REDIRECT_URI={KAKAO_REDIRECT_URI}
KAKAO_ADMIN_KEY={KAKAO_ADMIN_KEY}
JWT_SECRET={JWT_SECRET}
CORS_ALLOWED_ORIGINS={CORS_ALLOWED_ORIGINS}

# Backend AI 연동
AI_WEBSOCKET_URL={AI_WEBSOCKET_URL}
AI_HTTP_URL={AI_HTTP_URL}

# Backend S3
AWS_S3_BUCKET={AWS_S3_BUCKET}
AWS_S3_REGION={AWS_S3_REGION}

# Backend 오류 수집
SENTRY_DSN={SENTRY_DSN}
