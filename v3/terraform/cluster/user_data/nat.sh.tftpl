#!/bin/bash
# V3 NAT 인스턴스 첫 부팅 설정. Auto Scaling 그룹이 새로 띄울 때마다 실행된다.
# 1. IP 전달과 마스커레이드를 켜고 재부팅 뒤에도 유지한다.
# 2. 자기 출발지/목적지 검사를 끈다(자기 주소가 아닌 패킷을 전달하기 위해).
# 3. 같은 AZ의 EKS 라우팅 테이블 기본 경로를 자기 자신으로 바꾼다.
set -euo pipefail

printf 'net.ipv4.ip_forward = 1\n' > /etc/sysctl.d/90-nat.conf
sysctl -p /etc/sysctl.d/90-nat.conf

dnf install -y nftables
IFACE=$(ip -o -4 route show default | awk '{print $5}')
cat > /etc/sysconfig/nftables.conf <<NFT
flush ruleset
table ip nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr { ${eks_cidrs} } oifname "$IFACE" masquerade
  }
}
NFT
systemctl enable --now nftables
systemctl restart nftables

TOKEN=$(curl -sS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

aws ec2 modify-instance-attribute --region '${region}' --instance-id "$INSTANCE_ID" --no-source-dest-check

# 기본 경로가 없으면 만들고, 있으면(이전 NAT를 가리키면) 바꾼다
aws ec2 replace-route --region '${region}' --route-table-id '${route_table_id}' \
  --destination-cidr-block 0.0.0.0/0 --instance-id "$INSTANCE_ID" \
  || aws ec2 create-route --region '${region}' --route-table-id '${route_table_id}' \
  --destination-cidr-block 0.0.0.0/0 --instance-id "$INSTANCE_ID"
