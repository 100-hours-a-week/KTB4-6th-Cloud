{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "/meety/app/docker",
            "log_stream_name": "{app-id}",
            "timezone": "Local"
          },
          {
            "file_path": "/home/ubuntu/meety/nginx/logs/access.log",
            "log_group_name": "/meety/app/nginx-access",
            "log_stream_name": "{app-id}"
          },
          {
            "file_path": "/home/ubuntu/meety/nginx/logs/error.log",
            "log_group_name": "/meety/app/nginx-error",
            "log_stream_name": "{app-id}"
	  }
        ]
      }
    }
  }
}
