# ==================== 이미지 태그 ====================
# Docker Hub에 푸시한 이미지의 전체 경로:태그
# 예: docker.io/<username>/meety-fe:<커밋해시 또는 버전>
FRONTEND_IMAGE={Docker-Hub-Name}/{Image-Name}
BACKEND_IMAGE={Docker-Hub-Name}/{Image-Name}

# ==================== Frontend ====================
# BE API를 호출할 기준 URL (Nginx를 거치는 외부 도메인 또는 내부 경로)
API_BASE_URL=http://{BE-Container-Name}:8000
NEXT_PUBLIC_KAKAO_REST_API_KEY={NEXT_PUBLIC_KAKAO_REST_API_KEY}
NEXT_PUBLIC_KAKAO_REDIRECT_URI={NEXT_PUBLIC_KAKAO_REDIRECT_URI}
NEXT_PUBLIC_API_BASE_URL={NEXT_PUBLIC_API_BASE_UR}
NEXT_PUBLIC_GA_ID={NEXT_PUBLIC_GA_ID}
AUTH_COOKIE_DOMAIN={AUTH_COOKIE_DOMAIN}
BUG_REPORT_DISCORD_WEBHOOK_URL={BUG_REPORT_DISCORD_WEBHOOK_URL}

# ==================== Backend - 정책 ====================
# 하루 최대 회의 수
MEETING_DAILY_CREATE_LIMIT={MEETING_DAILY_CREATE_LIMIT}

# 팀이 보유할 수 있는 최대 크레딧 잔액
CREDIT_MAX_BALANCE={CREDIT_MAX_BALANCE}

# 팀 생성 시 최초 지급되는 크레딧
CREDIT_TEAM_CREATE_GRANT={CREDIT_TEAM_CREATE_GRANT}

# 매주 정기 지급되는 크레딧
CREDIT_WEEKLY_GRANT={CREDIT_WEEKLY_GRANT}

# 주간 크레딧 지급 스케줄, 현재 매주 월요일 00:00
CREDIT_WEEKLY_GRANT_CRON={CREDIT_WEEKLY_GRANT_CRON}

# 녹음 시작 시 차감되는 크레딧
CREDIT_RECORDING_COST={CREDIT_RECORDING_COST}

# 요약 재생성 시 차감되는 크레딧
CREDIT_SUMMARY_REGENERATE_COST={CREDIT_SUMMARY_REGENERATE_COST}

# AI 채팅 메시지 1회 요청 시 차감될 크레딧
CREDIT_AI_CHAT_MESSAGE_COST={CREDIT_AI_CHAT_MESSAGE_COST}

# 분석 리포트 생성 시 차감될 크레딧
CREDIT_ANALYSIS_REPORT_COST={CREDIT_ANALYSIS_REPORT_COST}

# ==================== Backend - DB/Redis ====================
# DB·Redis가 있는 EC2-micro의 사설 IP (VPC 내부 통신, 퍼블릭 IP 아님)
DATA_TIER_HOST={DATA_TIER_HOST}
DB_NAME={DB_NAME}
DB_USER={DB_USER}
DB_PASSWORD={DB_PASSWORD}
DB_ROOT_PASSWORD={DB_ROOT_PASSWORD}
CORS_ALLOWED_ORIGINS={CORS_ALLOWED_ORIGINS}

# ==================== Backend - 외부 연동 ====================
# 세션/토큰 서명용 시크릿. 충분히 긴 랜덤 문자열 사용 권장
KAKAO_CLIENT_ID={KAKAO_CLIENT_ID}
KAKAO_CLIENT_SECRET={KAKAO_CLIENT_SECRET}
KAKAO_REDIRECT_URI={KAKAO_REDIRECT_URI}
KAKAO_ADMIN_KEY={KAKAO_ADMIN_KEY}
CORS_ALLOWED_ORIGINS={CORS_ALLOWED_ORIGINS}
AI_WEBSOCKET_URL={AI_WEBSOCKET_URL}
AI_HTTP_URL={AI_HTTP_URL}
# AWS S3
AWS_S3_BUCKET={AWS_S3_BUCKET}
AWS_S3_REGION={AWS_S3_REGION}

# AWS 자격 증명
AWS_ACCESS_KEY_ID={AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY={AWS_SECRET_ACCESS_KEY}

JWT_SECRET={JWT_SECRET}

# JVM 힙 크기 조정이 필요할 때만 값 채우기. 비워두면 compose 기본값(-Xmx1024m -Xms512m) 적용
BE_IMAGE_TAG={Image-Tag}
FE_IMAGE_TAG={Image-Tag}
