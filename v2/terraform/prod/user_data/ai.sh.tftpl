#!/bin/bash
# prod AI 인스턴스(live, analysis) 초기 설정 (첫 부팅 때 1회 실행)
# 실행에 필요한 도구만 설치한다. 컨테이너와 nginx는 AI 저장소의 배포 workflow가 SSM으로 띄운다.
# prod 배포 workflow는 prod CI/CD를 붙일 때 만든다. 그 전까지 이 인스턴스에는 앱이 없다.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Docker와 AWS CLI 설치 (Ubuntu 26.04에는 AWS CLI apt 패키지가 없어 snap을 쓴다)
apt-get update
apt-get install -y docker.io
snap install aws-cli --classic
systemctl enable --now docker

install -d -m 700 /opt/meety
