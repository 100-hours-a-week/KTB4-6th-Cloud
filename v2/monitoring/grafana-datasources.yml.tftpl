# Grafana 데이터 소스. 서버가 시작할 때 자동으로 등록한다.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://loki:3100

  # ALB, ECS 지표와 CloudWatch 로그. 인스턴스 역할로 읽는다
  - name: CloudWatch
    type: cloudwatch
    uid: cloudwatch
    jsonData:
      authType: default
      defaultRegion: ${region}
