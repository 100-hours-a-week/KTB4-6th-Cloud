# 이미지 태그 (CI/CD가 관리)
AI_IMAGE_TAG={Image-Tag}

# 실시간 음성 인식
SPEECHMATICS_API_KEY={SPEECHMATICS_API_KEY}

# 분석 및 추적
OPENROUTER_API_KEY={OPENROUTER_API_KEY}
MODAL_TOKEN_ID={MODAL_TOKEN_ID}
MODAL_TOKEN_SECRET={MODAL_TOKEN_SECRET}
LANGSMITH_API_KEY={LANGSMITH_API_KEY}
LANGSMITH_PROJECT={LANGSMITH_PROJECT}
LANGSMITH_ENDPOINT={LANGSMITH_ENDPOINT}

# 오류 수집
MEETY_SENTRY_DSN={MEETY_SENTRY_DSN}

# 목업(가짜 공급자) 전환 — dev는 부하테스트용으로 목업을 기본으로 쓴다.
# deploy.sh·push-params.sh가 이 파일의 키를 필수 키로 검사하므로, 실제 공급자로 되돌리려면
# 아래 키를 이 파일과 .env에서 함께 빼고 Parameter Store(/meety/dev/ai)에서도 지운다.
AI_ENVIRONMENT=staging
AI_LIVE_APP=meety_ai.fake_providers:create_live_app
AI_ANALYSIS_APP=meety_ai.fake_providers:create_analysis_app
# 지연값(ms)은 생략하면 Compose 기본값(3000/15500/7000)을 쓴다.
FAKE_STT_LATENCY_MS=3000
FAKE_SUMMARY_LATENCY_MS=15500
FAKE_DIARIZATION_LATENCY_MS=7000
